# Copie este archivo como .env y ajuste los valores. El .env NUNCA se sube a Git.

# PostgreSQL. Con un PostgreSQL propio:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/vennex
# Con el PostgreSQL de desarrollo (python scripts/dev_postgres.py), use la URL que imprime ese script.

# Secreto para firmar los tokens JWT. Genere uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambie-este-valor-por-uno-aleatorio-de-32-o-mas
JWT_EXPIRE_MINUTES=60

# IA (opcional). Llave de Google AI Studio: https://aistudio.google.com/apikey
# Si se deja vacía, la app funciona igual y la clasificación se hace manualmente.
GEMINI_API_KEY=
# Uno o varios modelos separados por coma (si uno falla se usa el siguiente).
GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-3.5-flash-lite
